# Ye do ab per-user hain (Settings me daalte hain). Yahan sirf reference ke liye.
# APIFY_API_KEY=Your_API_Key
# OPENROUTER_API_KEY=Your_API_Key
DATABASE_URL=Your_Neon_Postgres_Connection_String

# APP_PASSWORD ab use nahi hota — asli accounts aa gaye (app/users.py).
# Har banda signup karta hai aur apni API keys deta hai.

# https par deploy karo to 1 kar do — session cookie tabhi Secure flag ke saath jaayegi.
COOKIE_SECURE=0

# Users ki API keys aur LinkedIn cookie isse encrypt hoti hain. Iske bina koi
# user apni keys save nahi kar sakta. Koi bhi lambi random string:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
APP_SECRET_KEY=

# Connection request kis raaste se jaaye: apify (sasta, kam bharosemand) ya unipile (paid)
CONNECT_PROVIDER=apify
UNIPILE_DSN=
UNIPILE_API_KEY=

# ── Forgot password (email) ────────────────────────────────────────
# Reset link isi base par banta hai. Deploy par apna asli URL daalo, warna
# email me localhost ka link jaayega.
APP_BASE_URL=http://localhost:10000

# Teen raaste, jo pehla set mile wahi use hota hai:
#
#   BREVO_API_KEY  — Render par YAHI lo. Free 300 mail/day, kisi bhi address
#                    par. Sirf sender email verify karna hota hai, domain nahi.
#   RESEND_API_KEY — domain verify kiye bina sirf apne hi email par bhej sakte ho
#   SMTP_*         — Gmail app password. Local par theek; Render ke free plan par
#                    outbound SMTP ports block hain, wahan ye chalega hi nahi.
#
# SMTP_FROM dono soorat me chahiye — bina uske koi provider select nahi hota.
BREVO_API_KEY=
RESEND_API_KEY=

# Gmail SMTP (local dev): 2FA on karo, phir
# https://myaccount.google.com/apppasswords se 16-character app password banao.
# Apna normal Gmail password yahan kaam NAHI karega.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tumhara@gmail.com
SMTP_PASS=abcd efgh ijkl mnop
SMTP_FROM=tumhara@gmail.com
SMTP_FROM_NAME=RAYN.AI

# Reset link kitne minute chalega.
RESET_TOKEN_MINUTES=30
